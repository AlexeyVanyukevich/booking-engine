{
  "name": "booking-engine",
  "version": "0.1.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "./run dev",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "openapi": "tsx scripts/openapi.ts",
    "format": "prettier --write .",
    "dev:debug": "./run debug",
    "migrate:built": "node dist/src/db/migrate.js",
    "test:watch": "vitest",
    "up": "./run up",
    "down": "./run down",
    "reset": "./run reset",
    "smoke": "./run smoke",
    "check": "./run check",
    "dev:server": "tsx watch src/server.ts",
    "debug:server": "tsx watch --inspect src/server.ts",
    "console": "node dist/src/console.js",
    "dev:console": "tsx watch src/console.ts",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "debug:console": "tsx watch --inspect=9230 src/console.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.10.0",
    "kysely": "^0.29.4",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
