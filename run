#!/usr/bin/env bash
#
# One entry point for every way of running this project.
# `./run` with no arguments lists the scenarios.
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# This script is what installs dependencies, so it cannot source out of node_modules before the
# kit is there. The test is for the file rather than the directory: a checkout installed before
# the kit became a dependency has node_modules without it.
#
# Until the kit is installed there is no `die`, so a missing npm is explained by hand here: a
# host with Docker alone would otherwise see only `npm: command not found`.
if [ ! -f node_modules/dev-kit/sh/lib.sh ]; then
  if ! command -v npm >/dev/null 2>&1; then
    printf '✗ ./run needs Node.js 24 and npm: its helpers come from the dev-kit package.\n' >&2
    printf '  Install Node 24 (see .nvmrc), or run the stack on Docker alone:  docker compose up -d --build\n' >&2
    exit 1
  fi
  printf '→ Installing dependencies, which ./run itself needs\n'
  npm install
fi
source node_modules/dev-kit/sh/lib.sh

# Recorded before `.env` is loaded, because afterwards there is no telling the two apart, and
# `resolve_running_port` needs to: an explicit port on the command line is an instruction,
# while one from the file is only a default that a running container may contradict.
PORT_FROM_SHELL="${PORT:+yes}"

# On the very first run `.env` does not exist yet; `need_env` creates it a moment later, and it
# takes effect from the next invocation. Nothing is lost — a fresh `.env` is a copy of
# `.env.example`, whose values are the defaults below.
load_env_file

APP_PORT="${PORT:-3000}"
CONSOLE_PORT="${CONSOLE_PORT:-3001}"
DB_HOST_PORT=5433
# PIDs and logs for whatever `--bg` started. Not the Docker stack — that is `./run up`.
RUN_STATE=".run"
COMPOSE_DB_URL="postgres://postgres:postgres@localhost:${DB_HOST_PORT}/booking_engine"

# Read by the kit's `need_node`: the floor is its default of 24, the pointer to `.nvmrc` is ours.
DEVKIT_NODE_HINT="Install Node 24 or newer — see .nvmrc."

# ── preflight ────────────────────────────────────────────────────────────────

# The kit's need_env creates .env and reports that it did; what the new file already points at
# is this project's to say. It returns non-zero on that first run, so it is never called bare.
need_local_env() {
  need_env && return 0
  note "DATABASE_URL already points at the compose database on port ${DB_HOST_PORT}"
}

# A busy port is fatal rather than a warning: Docker would otherwise fail several seconds
# later with "Bind for 0.0.0.0:3000 failed", which says nothing about who is holding it or
# what to do. Name the holder and offer the way out.
require_free_port() {
  local port=$1
  lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || return 0

  local holder
  holder=$(docker ps --format '{{.Names}}\t{{.Ports}}' 2>/dev/null | grep ":${port}->" | cut -f1 | head -1)

  # Our own stack holding the port is not a conflict — `up` on a running stack rebuilds it.
  case "$holder" in
    "$(basename "$PWD")-app-"*) return 0 ;;
  esac

  [ -z "$holder" ] && holder=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk 'NR==2 {print $1" (pid "$2")"}')

  die "Port ${port} is already in use by ${holder:-another process}." \
    "Stop it, or run this on another port:  PORT=3100 $0 ${SCENARIO:-up}"
}

# Scenarios that talk to an already-running engine must find it, not assume the default.
# A stack started as `PORT=3100 ./run up` is invisible to a later `./run docs` in a fresh
# shell, which would then point at whatever else owns 3000 — on this machine, a different
# project. Ask Docker where the container is actually published.
resolve_running_port() {
  # A port named on the command line is the answer; nothing may second-guess it.
  [ -n "$PORT_FROM_SHELL" ] && return 0
  command -v docker >/dev/null 2>&1 || return 0

  local published
  # `|| published=""` is load-bearing: with `pipefail`, a `docker compose port` that finds no
  # container makes the whole substitution non-zero, and `set -e` would abort the scenario
  # here with no message. Not finding a container is an ordinary answer, not a failure.
  published=$(docker compose port app 3000 2>/dev/null | sed -E 's/.*:([0-9]+)$/\1/') || published=""
  # An `if`, not `[ ... ] && ...`: this is the last statement of the function, and the `&&`
  # form returns 1 when the test is false, which under `set -e` aborts the caller with no
  # message at all.
  if [ -n "$published" ]; then
    APP_PORT="$published"
  fi

  # No further fallback: a `PORT` in `.env` is already in the environment by now, so
  # `APP_PORT` was computed from it above. A running container still wins over the file,
  # because the file says what the next start would use and the container says what is
  # answering right now.
}

# Distinguishes "nothing is listening" from "something else is listening", which are very
# different problems with very different fixes.
assert_engine_answers() {
  local base="http://localhost:${APP_PORT}"

  if curl -fsS -m 3 "$base/health" 2>/dev/null | grep -q '"status"'; then
    return 0
  fi

  if curl -s -m 3 -o /dev/null "$base/" 2>/dev/null && nc -z localhost "$APP_PORT" 2>/dev/null; then
    local holder
    holder=$(docker ps --format '{{.Names}}\t{{.Ports}}' 2>/dev/null | grep ":${APP_PORT}->" | cut -f1 | head -1)
    die "Port ${APP_PORT} is answering, but it is not this engine${holder:+ — it is ${holder}}." \
      "Start the engine with ./run up, or point at the right port:  PORT=<port> $0 ${SCENARIO:-docs}"
  fi

  die "Nothing is answering on ${base}." "Start it with ./run up or ./run dev, then try again."
}

# The reason this script exists: `docker compose up -d db` returns before Postgres
# accepts connections, so migrating immediately afterwards fails intermittently.
wait_for_db() {
  step "Waiting for the database to accept connections"
  local i
  for i in $(seq 1 60); do
    if docker compose exec -T db pg_isready -U postgres -d booking_engine >/dev/null 2>&1; then
      ok "Database ready"
      return 0
    fi
    sleep 1
  done
  die "The database did not become ready within 60 seconds." "Inspect it with: ./run logs db"
}

wait_for_app() {
  step "Waiting for the engine to answer"
  local i
  for i in $(seq 1 60); do
    if curl -fsS "http://localhost:${APP_PORT}/health" >/dev/null 2>&1; then
      ok "Engine healthy on http://localhost:${APP_PORT}"
      return 0
    fi
    sleep 1
  done
  die "The engine did not become healthy within 60 seconds." "Inspect it with: ./run logs app"
}

wait_for_console() {
  step "Waiting for the console to answer"
  local i
  for i in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:${CONSOLE_PORT}/tenants" >/dev/null 2>&1; then
      ok "Console ready on http://127.0.0.1:${CONSOLE_PORT}"
      return 0
    fi
    sleep 1
  done
  die "The console did not answer within 60 seconds." "Inspect it with: tail -f ${RUN_STATE}/console.log"
}

# ── the two local processes ──────────────────────────────────────────────────
#
# `dev` and `debug` start the engine *and* the console, because since spec 4 the engine
# refuses every request without an API key and the only place to issue one is the console.
# Starting either alone leaves you unable to use either.

local_prepare() {
  need_docker; need_node; need_deps; need_local_env
  require_free_port "$APP_PORT"
  require_free_port "$CONSOLE_PORT"
  step "Starting the database"
  docker compose up -d db
  wait_for_db
  step "Applying migrations"
  DATABASE_URL="$COMPOSE_DB_URL" npm run --silent migrate
}

# Pure bash rather than `sed -u`/`sed -l`, whose unbuffered flag is spelled differently on
# BSD and GNU. A read loop is line-oriented by nature and portable.
prefix_lines() {
  local label=$1 line
  while IFS= read -r line; do
    printf '%s%s%s %s\n' "$DIM" "$label" "$OFF" "$line"
  done
}

# Kills a process and everything below it. `npm run` forks the runner and `tsx watch` forks
# the process that actually holds the port, so killing only the launcher orphans the server.
kill_tree() {
  local pid=$1 child
  for child in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$child"; done
  kill "$pid" 2>/dev/null || true
}

# Both in this terminal, one Ctrl-C for the pair.
#
# The servers write to the same log files `--bg` uses and are followed by a `tail` apiece,
# rather than being piped through a labeller directly. That is deliberate: a piped background
# job records the PID of the *last* command in the pipeline, so a trap that kills it leaves
# the server running. Redirecting instead keeps `$!` pointing at the npm process itself,
# which is what `kill_tree` needs to walk.
run_pair_foreground() {
  local server_script=$1 console_script=$2 api_pid console_pid
  mkdir -p "$RUN_STATE"
  : >"$RUN_STATE/api.log"
  : >"$RUN_STATE/console.log"

  DATABASE_URL="$COMPOSE_DB_URL" \
    npm run --silent "$server_script" >>"$RUN_STATE/api.log" 2>&1 &
  api_pid=$!
  DATABASE_URL="$COMPOSE_DB_URL" CONSOLE_PORT="$CONSOLE_PORT" \
    npm run --silent "$console_script" >>"$RUN_STATE/console.log" 2>&1 &
  console_pid=$!

  tail -qf "$RUN_STATE/api.log" | prefix_lines "[api]    " &
  tail -qf "$RUN_STATE/console.log" | prefix_lines "[console]" &

  trap "stop_pair $api_pid $console_pid" INT TERM
  # Returns if either server exits on its own, which is a crash worth surfacing rather than
  # hanging on the survivor.
  wait "$api_pid" "$console_pid" 2>/dev/null || true
  stop_pair "$api_pid" "$console_pid"
}

stop_pair() {
  trap - INT TERM
  printf '\n'
  step "Stopping both"
  local pid
  for pid in "$@"; do
    kill_tree "$pid"
  done
  # The two `tail` jobs are the only children left.
  for pid in $(jobs -p); do
    kill "$pid" 2>/dev/null || true
  done
  ok "Stopped. The database keeps running; stop it with ./run down"
  exit 0
}

run_pair_background() {
  local server_script=$1 console_script=$2
  mkdir -p "$RUN_STATE"

  DATABASE_URL="$COMPOSE_DB_URL" \
    nohup npm run --silent "$server_script" >"$RUN_STATE/api.log" 2>&1 &
  echo $! >"$RUN_STATE/api.pid"

  DATABASE_URL="$COMPOSE_DB_URL" CONSOLE_PORT="$CONSOLE_PORT" \
    nohup npm run --silent "$console_script" >"$RUN_STATE/console.log" 2>&1 &
  echo $! >"$RUN_STATE/console.pid"

  wait_for_app
  wait_for_console
  note "Logs:  tail -f ${RUN_STATE}/api.log ${RUN_STATE}/console.log"
  note "Stop:  ./run stop        (the database keeps running; ./run down stops that)"
}

# ── scenarios ────────────────────────────────────────────────────────────────

# $1 is an optional --bg.
cmd_dev() {
  local_prepare
  # dev:server, not dev — `npm run dev` delegates back here and would recurse.
  if [ "${1:-}" = "--bg" ]; then
    step "Starting the engine and the console in the background, with reload"
    run_pair_background dev:server dev:console
  else
    step "Starting the engine and the console with reload"
    note "Engine   http://localhost:${APP_PORT}"
    note "Console  http://127.0.0.1:${CONSOLE_PORT}   — issue a key here before calling the engine"
    note "Press Ctrl-C to stop both. The database keeps running; stop it with ./run down"
    run_pair_foreground dev:server dev:console
  fi
}

cmd_debug() {
  local_prepare
  if [ "${1:-}" = "--bg" ]; then
    step "Starting both in the background with inspectors on 9229 and 9230"
    run_pair_background debug:server debug:console
  else
    step "Starting both with inspectors — engine on 9229, console on 9230"
    note "Two ports because two Node processes cannot share one inspector."
    note "Attach from VS Code, or open chrome://inspect"
    note "Press Ctrl-C to stop both."
    run_pair_foreground debug:server debug:console
  fi
}

cmd_stop() {
  local name pidfile pid stopped=0
  for name in api console; do
    pidfile="${RUN_STATE}/${name}.pid"
    [ -f "$pidfile" ] || continue
    pid=$(cat "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      step "Stopping ${name} (pid ${pid})"
      kill_tree "$pid"
      stopped=1
    fi
    rm -f "$pidfile"
  done

  if [ "$stopped" -eq 1 ]; then
    ok "Stopped. The database is still running — ./run down stops that."
  else
    note "Nothing was running in the background. The Docker stack is stopped with ./run down."
  fi
}

cmd_up() {
  need_docker
  require_free_port "$APP_PORT"
  step "Building and starting the full stack"
  docker compose up -d --build
  wait_for_app
  note "Logs:  ./run logs"
  note "Stop:  ./run down"
}

cmd_down() {
  need_docker
  step "Stopping the stack, keeping the data"
  docker compose down
  ok "Stopped. Data volume kept — use ./run reset to wipe it."
}

cmd_reset() {
  need_docker
  step "Wiping the database and rebuilding from scratch"
  docker compose down -v
  docker compose up -d --build
  wait_for_app
  ok "Fresh stack with an empty database"
}

cmd_test() {
  need_docker; need_node; need_deps
  note "The suite starts its own throwaway Postgres; the compose database is not used."
  npm run --silent test
}

cmd_test_ui() {
  need_docker; need_node; need_deps
  if [ ! -d "$HOME/Library/Caches/ms-playwright" ] && [ ! -d "$HOME/.cache/ms-playwright" ]; then
    die "No browser binary for Playwright." "Run: npx playwright install chromium"
  fi
  note "The console suite starts its own throwaway Postgres and both apps on ephemeral ports."
  npm run --silent test:ui
}

cmd_test_watch() {
  need_docker; need_node; need_deps
  npm run --silent test:watch
}

cmd_check() {
  need_node; need_deps
  step "Type checking"
  npx tsc --noEmit
  ok "No type errors"
  step "Formatting check"
  npx prettier --check . >/dev/null && ok "Formatting clean"
  cmd_test
}

cmd_logs() {
  need_docker
  docker compose logs -f "${1:-app}"
}

cmd_psql() {
  need_docker
  docker compose exec db psql -U postgres -d booking_engine
}

# Interactive API reference, generated from the same schemas the routes validate against.
cmd_docs() {
  resolve_running_port
  assert_engine_answers
  local url="http://localhost:${APP_PORT}/docs"
  ok "API reference: ${url}"
  note "Every endpoint has a Try it out button — no curl needed."
  if command -v open >/dev/null 2>&1; then open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"
  fi
}

# Rewrites the committed OpenAPI document from the route schemas. Needs no running engine and
# no database: the generator walks the registered routes, and no handler is called.
cmd_openapi() {
  need_node; need_deps
  npx tsx scripts/openapi.ts
  ok "openapi.json is current — commit it with the schema change that moved it"
}

# Replays the test-case datasets against a live engine. No case is written here — they all
# come from tests/fixtures/datasets/, the same source the automated suite reads, so editing
# a dataset changes this run too.
cmd_smoke() {
  need_node; need_deps
  resolve_running_port
  assert_engine_answers
  # $1 is an optional suite filter, passed straight through.
  BASE_URL="http://localhost:${APP_PORT}" npx tsx scripts/smoke.ts ${1:+"$1"}
}

cmd_help() {
  cat <<EOF
${BOLD}Usage:${OFF} ./run <scenario>

${BOLD}Develop${OFF}
  dev          Database in Docker; engine and console locally, with reload
  dev --bg     The same pair detached, logs in ${RUN_STATE}/
  debug        The pair with inspectors — engine on 9229, console on 9230
  debug --bg   The same, detached
  stop         Stop whatever --bg started (the database keeps running)
  psql         Open a psql shell on the development database

${BOLD}Run${OFF}
  up           Build and start the whole stack in Docker, detached
  down         Stop the stack, keeping the data
  reset        Wipe the database and start fresh
  logs [svc]   Follow logs, app by default
  docs         Open the interactive API reference in a browser
  openapi      Rewrite the committed openapi.json from the route schemas

${BOLD}Verify${OFF}
  test         Run the full suite once
  test:watch   Re-run tests on change
  test:ui      Console tests in a real browser (needs: npx playwright install chromium)
  check        Types, formatting and the full suite
  smoke [name] Replay the test-case suites against a running engine, optionally filtered

Every scenario checks its own prerequisites and explains what to do if one is missing.
Details: README.md · Test cases: docs/test-cases.md
EOF
}

# ── dispatch ─────────────────────────────────────────────────────────────────

SCENARIO="${1:-help}"
case "$SCENARIO" in
  dev)         cmd_dev "${2:-}" ;;
  debug)       cmd_debug "${2:-}" ;;
  stop)        cmd_stop ;;
  up)          cmd_up ;;
  down)        cmd_down ;;
  reset)       cmd_reset ;;
  test)        cmd_test ;;
  test:watch)  cmd_test_watch ;;
  test:ui)     cmd_test_ui ;;
  check)       cmd_check ;;
  logs)        cmd_logs "${2:-app}" ;;
  psql)        cmd_psql ;;
  docs)        cmd_docs ;;
  openapi)     cmd_openapi ;;
  smoke)       cmd_smoke "${2:-}" ;;
  help|-h|--help) cmd_help ;;
  *)
    printf '%sUnknown scenario: %s%s\n\n' "$RED" "$1" "$OFF" >&2
    cmd_help >&2
    exit 1
    ;;
esac
