# Read by `./run` for local scenarios and by docker compose for the stack.
# Plain KEY=value only: no quoting, no expansion, `#` starts a comment.
# A variable set on the command line wins:  PORT=3100 ./run dev
DATABASE_URL=postgres://postgres:postgres@localhost:5433/booking_engine
PORT=3000
LOG_LEVEL=info
MAX_RANGE_DAYS=366
DEFAULT_HOLD_MINUTES=10
MAX_HOLD_MINUTES=60
HOLD_SWEEP_INTERVAL_SECONDS=60
HOLD_SWEEP_ENABLED=true
CONSOLE_PORT=3001
RATE_LIMIT_PER_MINUTE=600
